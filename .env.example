# Root .env.example — used by docker-compose for variable substitution.
# Copy to `.env` and adjust values for your local environment.

# --- Postgres ---
POSTGRES_USER=aimed
POSTGRES_PASSWORD=aimed
POSTGRES_DB=aimed
POSTGRES_PORT=5432

# --- Backend ---
# DATABASE_URL is consumed by SQLAlchemy (async driver: asyncpg).
# Hostname `db` matches the compose service name.
DATABASE_URL=postgresql+asyncpg://aimed:aimed@db:5432/aimed
JWT_SECRET=change-me-in-local-env
# Legacy key: used as a fallback for LLM_API_KEY / ASR_API_KEY when they are empty.
# Leave blank if you use only local/self-hosted providers (LM Studio + Whisper).
OPENAI_API_KEY=
CORS_ORIGINS=http://localhost:5173
BACKEND_PORT=8000

# --- LLM (диагностический анализ) ---
# Вариант A (по умолчанию): LM Studio на Mac-хосте.
#   1. Запустите модель в LM Studio и включите локальный сервер (порт 1234).
#   2. LLM_MODEL — это имя/слаг модели в LM Studio (смотрите в интерфейсе).
# Вариант B: OpenAI  → LLM_BASE_URL=https://api.openai.com/v1, LLM_JSON_MODE=json_schema, LLM_MODEL=gpt-4o-mini
# Вариант C: DeepSeek → LLM_BASE_URL=https://api.deepseek.com/v1, LLM_MODEL=deepseek-chat, LLM_JSON_MODE=json_object
# Вариант D: Groq     → LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=llama-3.1-70b-versatile, LLM_JSON_MODE=json_object
LLM_API_KEY=
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_MODEL=qwen2.5-7b-instruct
# json_schema — строгая схема (OpenAI); json_object — обычный JSON-режим (LM Studio, Ollama, DeepSeek, Groq).
LLM_JSON_MODE=json_object

# --- ASR (распознавание речи) ---
# По умолчанию используется контейнер `whisper` (faster-whisper-server) из docker-compose.
# При первом запуске модель скачается в volume `whisper_models` (~460 MB для small).
# Альтернатива — OpenAI: ASR_BASE_URL=https://api.openai.com/v1 и ASR_MODEL=whisper-1.
ASR_API_KEY=
ASR_BASE_URL=http://whisper:8000/v1
ASR_MODEL=Systran/faster-whisper-small
WHISPER_PORT=9000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_PORT=5173
