# Backend-local .env.example.
# When running via docker-compose, variables are supplied by the root .env.
# Use this file as a reference when running backend outside of Docker.

DATABASE_URL=postgresql+asyncpg://aimed:aimed@localhost:5432/aimed
JWT_SECRET=change-me-in-local-env
# Legacy fallback. Leave empty if you use LM Studio + local Whisper.
OPENAI_API_KEY=
CORS_ORIGINS=http://localhost:5173

# LLM — LM Studio by default (server on the same Mac).
LLM_API_KEY=
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen2.5-7b-instruct
LLM_JSON_MODE=json_object

# ASR — faster-whisper-server (from docker-compose, mapped to host port 9000).
ASR_API_KEY=
ASR_BASE_URL=http://localhost:9000/v1
ASR_MODEL=Systran/faster-whisper-small
